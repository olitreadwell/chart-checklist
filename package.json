{
  "name": "chart-checklist",
  "version": "0.1.0",
  "private": true,
  "description": "A chart and data visualisation quality checklist for humans and AI agents.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
